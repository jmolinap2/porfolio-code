  },
  {
    date: "Abr 2024 – Sep 2024",
    title: "Analista de Datos",
    titleEn: "Data Analyst",
    company: "Metropolitan Touring C.A.",
    description: "Análisis y visualización de datos empresariales mediante Power BI, conectando con bases de datos Oracle y creando consultas complejas en PL/SQL.",
    descriptionEn: "Analysis and visualization of business data using Power BI, connecting to Oracle databases and creating complex PL/SQL queries.",
  },
  {

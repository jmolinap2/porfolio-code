    descriptionEn: "Development and maintenance of web modules using Angular and Node.js. Efficient queries on PostgreSQL and SQL Server for academic and administrative operations.",
  },
]

const EDUCATION = [
  {
    date: "2013 – 2019",
    title: "Ingeniería en Sistemas Computacionales",
    titleEn: "Computer Systems Engineering",
    company: "Universidad Estatal de Milagro",
    description: "Formación en desarrollo de software, bases de datos, redes, programación orientada a objetos y sistemas distribuidos.",
    descriptionEn: "Training in software development, databases, networks, object-oriented programming and distributed systems.",
  },
  {
    date: "2020",
    title: "CCNA R&S: Connecting Networks",
    titleEn: "CCNA R&S: Connecting Networks",
    company: "Cisco – Universidad Estatal de Milagro",
    description: "Certificación en redes: direccionamiento IP, protocolos de enrutamiento, seguridad de redes y configuración de routers y switches.",
    descriptionEn: "Networking certification: IP addressing, routing protocols, network security and router/switch configuration.",
  },
  {
    date: "2020",
    title: "Taller de REST APIs con Webex Teams",
    titleEn: "REST APIs with Webex Teams Workshop",
    company: "UNEMI – Emerging Technologies Workshop",

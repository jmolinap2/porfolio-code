]

const { type } = Astro.props
---

<div class="contenido-seccion">
  <div class="fila">
    <div class="col izquierda">
      <div class="item izq">
        {type === 'education'
          ? EDUCATION.map((edu) => <ExperienceItem {...edu} />)
          : WORK_EXPERIENCE.map((exp) => <ExperienceItem {...exp} />)
        }
      </div>
    </div>
  </div>
</div>

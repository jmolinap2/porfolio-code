---
---

<button
  id="lang-gear-btn"
  aria-label="Change language / Cambiar idioma"
  title="ES / EN"
  class="fixed bottom-6 right-6 z-50 text-purple-400 hover:text-purple-300 transition-colors"
>
  <svg
    id="lang-gear-icon"
    class="h-10 w-10"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9.4 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.09A1.65 1.65 0 0 0 9 3.09V3a2 2 0 1 1 4 0v.09c0 .69.4 1.3 1 1.51h.09a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.09c0 .7.39 1.3 1 1.51H21a2 2 0 1 1 0 4h-.09c-.7 0-1.3.4-1.51 1z" />
  </svg>
</button>

<style>
  @keyframes gear-click {
    0%   { transform: rotate(var(--base-rot, 0deg)); }
    40%  { transform: rotate(calc(var(--base-rot, 0deg) + 180deg)) scale(1.15); }
    100% { transform: rotate(calc(var(--base-rot, 0deg) + 360deg)); }
  }
  .gear-spinning {
    animation: gear-click 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
</style>

<script>
  function setup() {
    const btn  = document.getElementById('lang-gear-btn');
    const gear = document.getElementById('lang-gear-icon') as HTMLElement | null;
    if (!btn || !gear) return;

    let scrollRot = 0;

    window.addEventListener('scroll', () => {
      scrollRot = window.scrollY * 0.5;
      if (!gear.classList.contains('gear-spinning')) {
        gear.style.transform = `rotate(${scrollRot}deg)`;
      }
    }, { passive: true });

    btn.addEventListener('click', () => {
      const current = (() => { try { return localStorage.getItem('lang') || 'es'; } catch { return 'es'; } })();
      const next    = current === 'es' ? 'en' : 'es';

      gear.style.setProperty('--base-rot', `${scrollRot}deg`);
      gear.classList.remove('gear-spinning');
      void gear.offsetWidth; // reflow to restart animation
      gear.classList.add('gear-spinning');

      gear.addEventListener('animationend', () => {
        gear.classList.remove('gear-spinning');
        scrollRot += 360;
        gear.style.transform = `rotate(${scrollRot}deg)`;
      }, { once: true });

      // dispatch lang change (handled by Layout's global script)
      document.dispatchEvent(new CustomEvent('setlang', { detail: next }));
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>
